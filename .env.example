# Copy to .env and edit. .env is git-ignored.

# ---- HPC -------------------------------------------------------------------
# local = simulated Slurm cluster on your laptop (default)
# ssh   = real cluster; HPC_HOST must be a Host alias in ~/.ssh/config
HPC_BACKEND=local
HPC_HOST=mike
HPC_WORKDIR=/work/$USER/medphys_agents
HPC_PYTHON=python3
HPC_MODULES=python
SLURM_ACCOUNT=hpc_myalloc
SLURM_PARTITION=workq
POLL_SECONDS=30

# ---- LLM (optional) --------------------------------------------------------
# auto = use the model if a key is present; off = deterministic offline mode
MEDPHYS_LLM=auto
MEDPHYS_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
